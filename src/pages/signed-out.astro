<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>Signed Out | MTN OneUp Gaming Research</title>
    <style>
      :root {
        --primary: #083c4c;
        --accent: #02aa69;
        --mtn-yellow: #ffcb05;
        --bg: #f4f7f6;
        --card: #ffffff;
        --text: #0a0a0a;
        --muted: #4a5568;
        --border: #e2e8f0;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background:
          radial-gradient(circle at 12% 10%, rgba(255, 203, 5, 0.22), transparent 30%),
          radial-gradient(circle at 88% 8%, rgba(2, 170, 105, 0.17), transparent 34%),
          linear-gradient(180deg, #eaf4f1 0%, var(--bg) 100%);
        color: var(--text);
        display: grid;
        place-items: center;
        padding: 24px;
      }

      .card {
        width: min(100%, 460px);
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 20px 60px rgba(8, 60, 76, 0.12);
        position: relative;
        overflow: hidden;
      }

      .brand-strip {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 8px;
        background: linear-gradient(90deg, var(--mtn-yellow), var(--accent));
      }

      .brand-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 8px 0 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.4px;
        color: var(--primary);
        text-transform: uppercase;
      }

      .brand-kicker-badge {
        background: var(--mtn-yellow);
        color: var(--primary);
        border-radius: 6px;
        padding: 2px 8px;
      }

      h1 {
        margin: 0 0 8px;
        font-size: 28px;
      }

      p {
        margin: 0 0 12px;
        line-height: 1.5;
        color: var(--muted);
      }

      .status-note {
        margin: 0 0 14px;
        border-radius: 10px;
        border: 1px solid rgba(8, 60, 76, 0.2);
        background: rgba(8, 60, 76, 0.06);
        color: var(--primary);
        padding: 10px 12px;
        font-size: 13px;
      }

      a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 16px;
        border-radius: 12px;
        padding: 14px 16px;
        font: inherit;
        text-decoration: none;
        background: linear-gradient(90deg, var(--primary), #0b546c);
        color: #fff;
        font-weight: 700;
        transition: transform 0.15s ease, box-shadow 0.2s ease;
      }

      a:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(8, 60, 76, 0.22);
      }
    </style>
  </head>
  <body>
    <main class="card">
      <div class="brand-strip"></div>
      <div class="brand-kicker">
        <span class="brand-kicker-badge">MTN</span>
        OneUp Access
      </div>
      <h1>Signed out</h1>
      <p class="status-note">Your session has ended successfully.</p>
      <p>When you are ready, sign in again with your approved work email to continue to the dashboard.</p>
      <a href="/auth">Sign in again</a>
    </main>
  </body>
</html>
